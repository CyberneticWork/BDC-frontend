# React SPA (HR frontend) — urbanhr / jcfood / spmhr
# Direct URLs like /cybernetic-admin and /dashboard must fall through to index.html.
# Without try_files, nginx returns its own "404 Not Found".

server {
    listen 443 ssl http2;
    server_name urbanhr.cyberneticde.site;

    root /var/www/sohan_hr_system_frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
